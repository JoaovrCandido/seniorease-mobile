{
  "expo": {
    "name": "SeniorEase",
    "slug": "seniorease-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0056D2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seunome.seniorease"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#0056D2"
      },
      "package": "com.seunome.seniorease"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "O SeniorEase precisa do microfone para que possa ditar as suas anotações em vez de escrever.",
          "speechRecognitionPermission": "O SeniorEase precisa do reconhecimento de voz para transformar a sua fala em texto."
        }
      ]
    ]
  }
}
